# Configuración del Importador Local de AgendaFest
PORT=3030
HOST=127.0.0.1

# Proveedor de IA. Gemini funciona en el nivel gratuito sin facturación.
AI_PROVIDER=mock
GEMINI_API_KEY=

# Configuración de Mocks / Estimador
IA_MODEL=gemini-3.5-flash
IA_COST_INPUT_PM=0.0
IA_COST_OUTPUT_PM=0.0

# Debe permanecer false para COSTE 0. La búsqueda integrada de Google no está
# disponible en el nivel gratuito de Gemini 3.5 Flash.
GEMINI_SEARCH_GROUNDING=false

# Spotify Web API (requiere una cuenta Premium activa en modo desarrollo)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# YouTube Data API v3. Mantén la facturación desactivada; el importador usa
# como máximo una búsqueda por artista y conserva los resultados 30 días.
YOUTUBE_API_KEY=

# Configuración del Ciclo de Vida y Despliegue
PUBLISH_ENABLED=false
GITHUB_TOKEN=your_github_personal_access_token_here
