# Configuración del Importador Local de AgendaFest
PORT=3030
HOST=127.0.0.1

# Proveedor de IA (Usar 'mock' para Incremento 1)
AI_PROVIDER=mock

# Configuración de Mocks / Estimador
IA_MODEL=mock-model
IA_COST_INPUT_PM=0.0
IA_COST_OUTPUT_PM=0.0

# Configuración del Ciclo de Vida y Despliegue
PUBLISH_ENABLED=false
GITHUB_TOKEN=your_github_personal_access_token_here
